<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.x.Otto.desktop</id>
  <launchable type="desktop-id">org.x.Otto.desktop</launchable>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>
  <name>Otto</name>
  <summary>Take screenshots of your screen, windows, or selected areas</summary>
  <description>
    <p>
      Otto is a small screenshot utility for the Cinnamon desktop. It can capture
      the entire screen, the active window, or a region selected with the mouse,
      and offers a quick post-capture editor for cropping, rotating, and flipping
      the result before saving or copying to the clipboard.
    </p>
    <p>
      Otto is a drop-in replacement for gnome-screenshot on Linux Mint and aims
      to keep its command-line interface compatible.
    </p>
  </description>
  <url type="bugtracker">https://github.com/linuxmint/otto/issues</url>
  <translation type="gettext">otto</translation>
  <content_rating type="oars-1.1"/>
</component>
